				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse the JSON response body into a variable",
							"const jsonData = pm.response.json();",
							"",
							"// ---------------------------------------------------",
							"// 1. Basic Status & Performance Checks",
							"// ---------------------------------------------------",
							"",
							"// Check if the HTTP status code is 200 OK",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Check if the response time is acceptable (e.g., under 2000ms)",
							"pm.test(\"Response time is less than 2000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// Check if the response Content-Type is JSON",
							"pm.test(\"Content-Type is application/json\", function () {",
							"    pm.response.to.be.json;",
							"});",
							"",
							"// ---------------------------------------------------",
							"// 2. Data Validation (Based on Example Response)",
							"// ---------------------------------------------------",
							"",
							"// Verify that specific fields exist and contain the expected values",
							"pm.test(\"Validate Aaron's Profile Information\", function () {",
							"    // Note: Using bracket notation because keys have spaces (e.g., \"first name\")",
							"    ",
							"    // Check First Name",
							"    pm.expect(jsonData[\"first name\"]).to.eql(\"Aaron\");",
							"    ",
							"    // Check Last Name",
							"    pm.expect(jsonData[\"last name\"]).to.eql(\"Chen\");",
							"    ",
							"    // Check College",
							"    pm.expect(jsonData[\"college\"]).to.eql(\"NCU\");",
							"    ",
							"    // Check Year",
							"    pm.expect(jsonData[\"year\"]).to.eql(\"junior\");",
							"    ",
							"    // Check Position",
							"    pm.expect(jsonData[\"position\"]).to.eql(\"backend\");",
							"});",
							"",
							"// ---------------------------------------------------",
							"// 3. Schema/Data Type Validation",
							"// ---------------------------------------------------",
							"",
							"// Verify that the data types are correct (Strings)",
							"pm.test(\"Validate Data Types\", function () {",
							"    pm.expect(jsonData[\"first name\"]).to.be.a(\"string\");",
							"    pm.expect(jsonData[\"last name\"]).to.be.a(\"string\");",
							"    pm.expect(jsonData[\"college\"]).to.be.a(\"string\");",
							"    pm.expect(jsonData[\"year\"]).to.be.a(\"string\");",
							"    pm.expect(jsonData[\"position\"]).to.be.a(\"string\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
