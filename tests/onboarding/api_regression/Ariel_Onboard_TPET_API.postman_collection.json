			"name": "Onboarding Self Introduction",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1. Check if the status code is 200 OK\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// 2. Validate response time (Should be under 1000ms for Lambda cold starts)\r",
							"pm.test(\"Response time is less than 1000ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
							"});\r",
							"\r",
							"// 3. Ensure the response body is in JSON format\r",
							"pm.test(\"Response should be JSON\", function () {\r",
							"    pm.response.to.be.withBody;\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"// 4. Validate the response schema and content\r",
							"pm.test(\"Response body matches the expected schema and content\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    \r",
							"    // Check if required fields exist\r",
							"    pm.expect(jsonData).to.have.property('name');\r",
							"    pm.expect(jsonData).to.have.property('introduction');\r",
							"    pm.expect(jsonData).to.have.property('onboarding_path');\r",
							"\r",
							"    // Validate field values\r",
							"    pm.expect(jsonData.name).to.be.a('string');\r",
							"    pm.expect(jsonData.introduction).to.include(\"Hi, I am Ariel\");\r",
							"    pm.expect(jsonData.onboarding_path).to.equal(\"/onboarding_ariel\");\r",
							"});\r",
							"\r",
							"// 5. Check Content-Type header\r",
							"pm.test(\"Content-Type is application/json\", function () {\r",
							"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
